# ==============================================================================
# RepoRAG Backend Environment Variables
# ==============================================================================

# Server Configuration
PROJECT_NAME="RepoRAG"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS='["http://localhost:5173", "http://localhost:5178", "http://127.0.0.1:5173", "http://127.0.0.1:5178", "http://localhost:3000"]'

# GitHub API Credentials
# Recommended: Adding a GitHub Personal Access Token increases the rate limit from 60 to 5,000 req/hr
GITHUB_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI & LLM Provider Settings
# Options: "gemini" | "openai" | "local"
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_MODEL="gemini-1.5-flash"

# Vector Database & Embeddings
# VECTOR_DB_TYPE: "memory" | "chroma"
VECTOR_DB_TYPE="memory"
VECTOR_DB_DIR="./data/vector_db"

# EMBEDDING_PROVIDER: "local" (TF-IDF / MinHash) | "gemini" | "openai"
EMBEDDING_PROVIDER="local"

# File Processing & Safety Limits
MAX_FILE_SIZE_BYTES=512000
